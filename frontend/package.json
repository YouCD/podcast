{
  "name": "podcast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:pro": "vue-tsc && vite build -m pro",
    "build:test": "vue-tsc && vite build  -m test",
    "run:test": "vite --host 0.0.0.0 -m test",
    "run:pro": "vite --host 0.0.0.0 -m pro",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@devui-design/icons": "^1.4.0",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@matechat/core": "^1.11.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "dompurify": "3.3.2",
    "echarts": "^6.0.0",
    "graphql": "^16.12.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "pinia": "^3.0.3",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue-advanced-chat": "^2.1.2",
    "vue-devui": "^1.6.36",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint-plugin-oxlint": "~1.23.0",
    "jiti": "^2.6.1",
    "miniprogram-api-typings": "^4.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "prettier": "3.6.2",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-devtools-oxlint": "^0.2.3",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  }
}
